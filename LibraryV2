local function markIconPart(instance)
	instance:SetAttribute("AlphaxIconPart", true)
	return instance
end

local function setVectorIconColor(holder, color)
	if not holder then
		return
	end

	for _, object in ipairs(holder:GetDescendants()) do
		if object:GetAttribute("AlphaxIconPart") then
			if object:IsA("Frame") then
				object.BackgroundColor3 = color
			elseif object:IsA("UIStroke") then
				object.Color = color
			end
		end
	end
end

local function iconLine(parent, position, size, rotation, color, zIndex, radius)
	local line = markIconPart(create("Frame", {
		Position = position,
		Size = size,
		Rotation = rotation or 0,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = zIndex or 2,
		Parent = parent,
	}))

	addCorner(line, radius or 2)
	return line
end

local function createVectorIcon(parent, iconName, color, zIndex)
	local holder = create("Frame", {
		Name = "VectorIcon",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = zIndex or 2,
		Parent = parent,
	})

	iconName = string.lower(tostring(iconName or "diamond"))
	color = color or Color3.new(1, 1, 1)
	zIndex = zIndex or 2

	if iconName == "home" or iconName == "diamond" or iconName == "visual" then
		local diamond = markIconPart(create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(iconName == "visual" and 9 or 8, iconName == "visual" and 9 or 8),
			Rotation = 45,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
			Parent = holder,
		}))
		addCorner(diamond, 2)

		if iconName == "visual" then
			iconLine(holder, UDim2.new(0.5, 6, 0.5, -8), UDim2.fromOffset(2, 6), 0, color, zIndex + 1, 1)
			iconLine(holder, UDim2.new(0.5, 4, 0.5, -6), UDim2.fromOffset(6, 2), 0, color, zIndex + 1, 1)
		end

	elseif iconName == "controls" or iconName == "circle" then
		local ring = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(13, 13),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
			Parent = holder,
		})
		addCorner(ring, 7)
		markIconPart(addStroke(ring, color, 0, 2))

		local dot = markIconPart(create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(4, 4),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex + 2,
			Parent = holder,
		}))
		addCorner(dot, 2)

	elseif iconName == "inputs" or iconName == "menu" then
		local ys = {0.32, 0.50, 0.68}
		for _, y in ipairs(ys) do
			iconLine(
				holder,
				UDim2.new(0.5, -7, y, -1),
				UDim2.fromOffset(14, 2),
				0,
				color,
				zIndex + 1,
				1
			)
		end

	elseif iconName == "config" or iconName == "settings" then
		local ring = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(11, 11),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
			Parent = holder,
		})
		addCorner(ring, 6)
		markIconPart(addStroke(ring, color, 0, 2))

		for index = 0, 3 do
			local rotation = index * 45
			iconLine(
				holder,
				UDim2.new(0.5, -1, 0.5, -9),
				UDim2.fromOffset(2, 5),
				rotation,
				color,
				zIndex + 1,
				1
			)
		end

	elseif iconName == "chevron" or iconName == "down" then
		iconLine(holder, UDim2.new(0.5, -7, 0.5, -1), UDim2.fromOffset(9, 2), 45, color, zIndex + 1, 1)
		iconLine(holder, UDim2.new(0.5, -1, 0.5, -1), UDim2.fromOffset(9, 2), -45, color, zIndex + 1, 1)

	elseif iconName == "close" then
		iconLine(holder, UDim2.new(0.5, -7, 0.5, -1), UDim2.fromOffset(14, 2), 45, color, zIndex + 1, 1)
		iconLine(holder, UDim2.new(0.5, -7, 0.5, -1), UDim2.fromOffset(14, 2), -45, color, zIndex + 1, 1)

	elseif iconName == "minimize" then
		iconLine(holder, UDim2.new(0.5, -7, 0.5, -1), UDim2.fromOffset(14, 2), 0, color, zIndex + 1, 1)

	else
		-- Fallback seguro: ponto circular, sem texto Unicode.
		local dot = markIconPart(create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
			Parent = holder,
		}))
		addCorner(dot, 3)
	end

	return holder
end

local function colorToHex(color)
	local rgb = colorToTable(color)
	return string.format("#%02X%02X%02X", rgb.R, rgb.G, rgb.B)
end

local function hexToColor(text)
	text = tostring(text or ""):gsub("#", ""):gsub("%s+", "")

	if #text == 3 then
		text =
			text:sub(1, 1) .. text:sub(1, 1)
			.. text:sub(2, 2) .. text:sub(2, 2)
			.. text:sub(3, 3) .. text:sub(3, 3)
	end

	if #text ~= 6 or not text:match("^[%x]+$") then
		return nil
	end

	local r = tonumber(text:sub(1, 2), 16)
	local g = tonumber(text:sub(3, 4), 16)
	local b = tonumber(text:sub(5, 6), 16)

	if not r or not g or not b then
		return nil
	end

	return Color3.fromRGB(r, g, b)
end

