--// ============================================================
--// SEGMENTED CONTROL
--// ============================================================

function Section:AddSegmented(options)
	options = options or {}

	local theme = self.Window.Theme
	local name = options.Name or "Mode"
	local description = options.Description or ""
	local values = options.Options or {"A", "B"}
	local selected = options.Default or values[1]

	if #values == 0 then
		values = {"A"}
		selected = "A"
	end

	local row = self:_CreateRow(
		description ~= "" and 100 or 86,
		name .. " " .. description .. " " .. table.concat(values, " ")
	)

	self:_CreateTextBlock(row, name, description, UDim2.new(1, 0, 0, 54))

	local holder = create("Frame", {
		Position = UDim2.new(0, 16, 1, -44),
		Size = UDim2.new(1, -32, 0, 32),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(holder, 12)
	addStroke(holder, theme.StrokeSoft, 0.42, 1)

	local count = math.max(#values, 1)
	local buttons = {}
	local buttonScales = {}
	local controller = {}

	-- Um único pill fica atrás dos botões e desliza até o selecionado.
	local selection = create("Frame", {
		Name = "Selection",
		Position = UDim2.new(0, 3, 0, 3),
		Size = UDim2.new(1 / count, -6, 1, -6),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = holder,
	})

	addCorner(selection, 9)
	local selectionStroke = addStroke(
		selection,
		theme.Accent2,
		0.38,
		1
	)

	local selectionGlow = create("Frame", {
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = theme.Accent2,
		BackgroundTransparency = 0.90,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = selection,
	})
	addCorner(selectionGlow, 7)

	local function getIndex(value)
		return table.find(values, value) or 1
	end

	local function targetPosition(index)
		return UDim2.new(
			(index - 1) / count,
			3,
			0,
			3
		)
	end

	local function render(animate)
		local selectedIndex = getIndex(selected)

		if animate then
			tween(
				selection,
				0.30,
				{
					Position = targetPosition(selectedIndex),
				},
				Enum.EasingStyle.Quint
			)

			tween(
				selectionGlow,
				0.14,
				{BackgroundTransparency = 0.78},
				Enum.EasingStyle.Quint
			)

			task.delay(0.14, function()
				if selectionGlow and selectionGlow.Parent then
					tween(
						selectionGlow,
						0.18,
						{BackgroundTransparency = 0.90},
						Enum.EasingStyle.Quint
					)
				end
			end)
		else
			selection.Position = targetPosition(selectedIndex)
		end

		for value, button in pairs(buttons) do
			local active = value == selected

			tween(button, 0.18, {
				TextColor3 = active
					and getContrastTextColor(theme.Accent)
					or theme.Muted,
			})

			local scaleObject = buttonScales[value]

			if scaleObject then
				tween(
					scaleObject,
					0.18,
					{Scale = active and 1.025 or 1},
					active
						and Enum.EasingStyle.Back
						or Enum.EasingStyle.Quint
				)
			end
		end
	end

	function controller:Set(newValue, fireCallback)
		if not table.find(values, newValue) then
			return false
		end

		if selected == newValue then
			return true
		end

		selected = newValue
		render(true)

		if fireCallback ~= false then
			safeCallback(options.Callback, selected)
		end

		return true
	end

	function controller:Get()
		return selected
	end

	for index, value in ipairs(values) do
		local button = create("TextButton", {
			AutoButtonColor = false,
			Position = UDim2.new(
				(index - 1) / count,
				3,
				0,
				3
			),
			Size = UDim2.new(
				1 / count,
				-6,
				1,
				-6
			),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = tostring(value),
			TextColor3 = theme.Muted,
			TextSize = 10,
			ZIndex = 12,
			Parent = holder,
		})

		local buttonScale = create("UIScale", {
			Scale = 1,
			Parent = button,
		})

		buttons[value] = button
		buttonScales[value] = buttonScale

		self.Window.Maid:Give(button.MouseEnter:Connect(function()
			if selected ~= value then
				tween(
					buttonScale,
					0.13,
					{Scale = 1.018},
					Enum.EasingStyle.Quint
				)
			end
		end))

		self.Window.Maid:Give(button.MouseLeave:Connect(function()
			if selected ~= value then
				tween(
					buttonScale,
					0.13,
					{Scale = 1},
					Enum.EasingStyle.Quint
				)
			end
		end))

		self.Window.Maid:Give(button.MouseButton1Down:Connect(function()
			tween(
				buttonScale,
				0.07,
				{Scale = 0.96},
				Enum.EasingStyle.Quint
			)
		end))

		self.Window.Maid:Give(button.MouseButton1Up:Connect(function()
			tween(
				buttonScale,
				0.12,
				{
					Scale = selected == value
						and 1.025
						or 1.018,
				},
				Enum.EasingStyle.Back
			)
		end))

		self.Window.Maid:Give(button.MouseButton1Click:Connect(function()
			controller:Set(value, true)
		end))
	end

	self.Window:BindAccent(function(accent)
		selection.BackgroundColor3 = accent
		selectionStroke.Color = self.Window.Theme.Accent2
		selectionGlow.BackgroundColor3 = self.Window.Theme.Accent2

		-- Mantém contraste correto se a accent mudar pelo ColorPicker.
		for value, button in pairs(buttons) do
			if value == selected then
				button.TextColor3 = getContrastTextColor(accent)
			end
		end
	end)

	render(false)

	self.Window:_RegisterControl(options.Id, controller)
	return controller
end


