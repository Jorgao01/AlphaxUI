function Section:AddSegmented(options)
	options = options or {}

	local theme = self.Window.Theme
	local name = options.Name or "Mode"
	local description = options.Description or ""
	local values = options.Options or {"A", "B"}
	local selected = options.Default or values[1]

	local row = self:_CreateRow(
		description ~= "" and 100 or 86,
		name .. " " .. description .. " " .. table.concat(values, " ")
	)

	self:_CreateTextBlock(row, name, description, UDim2.new(1, 0, 0, 54))

	local holder = create("Frame", {
		Position = UDim2.new(0, 16, 1, -44),
		Size = UDim2.new(1, -32, 0, 32),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(holder, 9)
	addPadding(holder, 4, 4, 4, 4)

	local layout = create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 4),
		Parent = holder,
	})

	local buttons = {}
	local controller = {}

	local function render()
		for value, button in pairs(buttons) do
			local active = value == selected

			tween(button, 0.14, {
				BackgroundTransparency = active and 0 or 1,
				BackgroundColor3 = active and theme.Accent or theme.Surface,
				TextColor3 = active and Color3.fromRGB(255, 255, 255) or theme.Muted,
			})
		end
	end

	function controller:Set(newValue, fireCallback)
		if not table.find(values, newValue) then
			return
		end

		selected = newValue
		render()

		if fireCallback ~= false then
			safeCallback(options.Callback, selected)
		end
	end

	function controller:Get()
		return selected
	end

	for _, value in ipairs(values) do
		local button = create("TextButton", {
			AutoButtonColor = false,
			Size = UDim2.new(1 / math.max(#values, 1), -4, 1, 0),
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = tostring(value),
			TextColor3 = theme.Muted,
			TextSize = 10,
			ZIndex = 11,
			Parent = holder,
		})

		addCorner(button, 7)
		buttons[value] = button

		self.Window.Maid:Give(button.MouseButton1Click:Connect(function()
			controller:Set(value, true)
		end))
	end

	self.Window:BindAccent(function(accent)
		for value, button in pairs(buttons) do
			if value == selected then
				button.BackgroundColor3 = accent
			end
		end
	end)

	render()

	self.Window:_RegisterControl(options.Id, controller)
