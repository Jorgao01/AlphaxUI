		tween(
			switchScale,
			0.14,
			{
				Scale = 1,
			},
			Enum.EasingStyle.Quint
		)

		tween(switchGlow, 0.14, {
			BackgroundTransparency = value and 0.78 or 1,
		})
	end))

	local function render()
		tween(switch, 0.18, {
			BackgroundColor3 = value and theme.Accent or theme.Surface4,
		})

		tween(knob, 0.18, {
			Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 17, 0.5, 0),
		})

		tween(switchGlow, 0.18, {
			BackgroundTransparency = value and 0.78 or 1,
		})

		switchStroke.Color = value and theme.Accent2 or theme.Stroke
		switchStroke.Transparency = value and 0.1 or 0.45
	end

	self.Window:BindAccent(function(accent)
		switchGlow.BackgroundColor3 = accent

		if value then
			switch.BackgroundColor3 = accent
			switchStroke.Color = accent
		end
	end)

	function controller:Set(newValue, fireCallback)
		value = newValue == true
		render()

		if fireCallback ~= false then
			safeCallback(options.Callback, value)
		end
	end

	function controller:Get()
		return value
	end

	self.Window.Maid:Give(hit.MouseButton1Click:Connect(function()
		controller:Set(not value, true)
	end))

	self.Window:_RegisterControl(options.Id, controller)

	if options.FireOnLoad then
		safeCallback(options.Callback, value)
	end

	return controller
end

