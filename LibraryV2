		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(switch, 17)
	local switchStroke = addStroke(
		switch,
		value and theme.Accent2 or theme.Stroke,
		value and 0.1 or 0.45,
		1
	)

	local switchGlow = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 10, 1, 10),
		BackgroundColor3 = theme.Accent,
		BackgroundTransparency = value and 0.78 or 1,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = switch,
	})
	addCorner(switchGlow, 22)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 17, 0.5, 0),
		Size = UDim2.fromOffset(27, 27),
		BackgroundColor3 = Color3.fromRGB(248, 248, 252),
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = switch,
	})

	addCorner(knob, 14)
	addStroke(knob, Color3.fromRGB(255, 255, 255), 0.45, 1)

	local hit = create("TextButton", {
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 12,
		Parent = row,
	})

	local controller = {}

	local function render()
		tween(switch, 0.18, {
			BackgroundColor3 = value and theme.Accent or theme.Surface4,
		})

		tween(knob, 0.18, {
			Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 17, 0.5, 0),
		})

		tween(switchGlow, 0.18, {
			BackgroundTransparency = value and 0.78 or 1,
		})

		switchStroke.Color = value and theme.Accent2 or theme.Stroke
		switchStroke.Transparency = value and 0.1 or 0.45
	end

