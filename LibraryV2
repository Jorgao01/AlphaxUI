		Parent = row,
	})
	corner(selector, 8)

	local list = new("Frame", {
		Position = UDim2.new(0, 0, 1, 6),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 20,
		Parent = row,
	})
	corner(list, 10)
	stroke(list, theme.Stroke, 0.25, 1)

	local scroll = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = theme.Accent,
		ZIndex = 21,
		Parent = list,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 4),
		Parent = scroll,
	})
	padding(scroll, 6, 6, 6, 6)

	local controller = {}

	local function rebuild()
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for _, option in ipairs(values) do
			local optionButton = new("TextButton", {
				AutoButtonColor = false,
				Size = UDim2.new(1, -4, 0, 30),
				BackgroundColor3 = theme.Surface2,
				BorderSizePixel = 0,
				Font = Enum.Font.Gotham,
				Text = tostring(option),
				TextColor3 = theme.Text,
				TextSize = 10,
				ZIndex = 22,
				Parent = scroll,
			})
			corner(optionButton, 7)
			optionButton.MouseButton1Click:Connect(function()
				controller:Set(option, true)
				open = false
				tween(list, 0.14, {Size = UDim2.new(1, 0, 0, 0)})
				task.delay(0.15, function()
					list.Visible = false
				end)
				row.Size = UDim2.new(1, 0, 0, 46)
			end)
		end
	end

	function controller:Set(value, fireCallback)
		selected = value
		selector.Text = tostring(value)
		if fireCallback ~= false then
			safeCallback(options.Callback, selected)
		end
	end

	function controller:Get()
		return selected
	end

	function controller:SetOptions(newOptions, preserveSelection)
		values = newOptions or {}
		if not preserveSelection or not table.find(values, selected) then
			selected = values[1]
		end
		selector.Text = tostring(selected or "Selecionar")
		rebuild()
	end

	rebuild()

	selector.MouseButton1Click:Connect(function()
		open = not open
		list.Visible = true
		local itemCount = math.min(#values, 5)
		local targetHeight = open and (itemCount * 34 + 12) or 0
		local rowHeight = open and (52 + targetHeight) or 46
		tween(list, 0.16, {Size = UDim2.new(1, 0, 0, targetHeight)})
		tween(row, 0.16, {Size = UDim2.new(1, 0, 0, rowHeight)})
		if not open then
			task.delay(0.17, function()
				if not open then
					list.Visible = false
				end
			end)
		end
	end)

	self.Window:_registerControl(options.Id, controller)
	return controller
end

