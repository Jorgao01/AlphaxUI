function AlphaxUI:CreateWindow(options)
	options = options or {}

	local themeName = options.Theme or "Midnight"
	local baseTheme = Themes[themeName] or Themes.Midnight
	local theme = mergeTable(baseTheme, options.ThemeOverrides)

	if typeof(options.Accent) == "Color3" then
		theme.Accent = options.Accent
	end

	if typeof(options.Accent2) == "Color3" then
		theme.Accent2 = options.Accent2
	end

	local self = setmetatable({}, Window)

	self.Theme = theme
	self.ThemeName = themeName
	self.Maid = Maid.new()

	-- Customização pública da janela.
	self.Options = options
	self.AnimationSpeed = math.clamp(tonumber(options.AnimationSpeed) or 1, 0.35, 3)
	self.InterfaceScale = math.clamp(tonumber(options.Scale) or 1, 0.65, 1.45)

	-- Blur mais leve:
	-- loading = no máximo 2px
	-- UI aberta = padrão 4px
	self.BlurSize = math.clamp(tonumber(options.BlurSize) or 4, 0, 8)
	self.LoadingBlurSize = math.min(self.BlurSize, 2)
	self.CornerRadius = math.clamp(tonumber(options.CornerRadius) or 28, 14, 44)
	self.CardRadius = math.clamp(tonumber(options.CardRadius) or 17, 8, 30)
	self.SidebarWidth = math.clamp(tonumber(options.SidebarWidth) or 244, 190, 340)
	self.MobileBreakpoint = math.clamp(tonumber(options.MobileBreakpoint) or 760, 480, 1100)
	-- Loading 2.0.0:
	-- obrigatório e padronizado pela biblioteca.
	self.LoadingEnabled = true
	self.LoadingDuration = 5
	self.LoadingTitle = tostring(options.Title or "Alphax")
