			Position = UDim2.new(currentH, 0, 0.5, 0),
			Size = UDim2.fromOffset(6, 22),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 144,
			Parent = hue,
		})
		addCorner(hueCursor, 3)
		addStroke(hueCursor, Color3.new(0, 0, 0), 0.42, 1)

		local info = create("Frame", {
			Position = UDim2.fromOffset(16, 258),
			Size = UDim2.new(1, -32, 0, 58),
			BackgroundColor3 = theme.Surface2,
			BorderSizePixel = 0,
			ZIndex = 141,
			Parent = popup,
		})
		addCorner(info, 12)
		addStroke(info, theme.StrokeSoft, 0.28, 1)

		local livePreview = create("Frame", {
			Position = UDim2.fromOffset(9, 9),
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = value,
			BorderSizePixel = 0,
			ZIndex = 142,
			Parent = info,
		})
		addCorner(livePreview, 10)
		addStroke(livePreview, Color3.new(1, 1, 1), 0.70, 1)

		local rgbText = create("TextLabel", {
			Position = UDim2.fromOffset(60, 6),
			Size = UDim2.new(0.44, -10, 0, 20),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = "",
			TextColor3 = theme.Muted,
			TextSize = 9,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 142,
			Parent = info,
		})

		local hexBox = create("TextBox", {
			Position = UDim2.fromOffset(60, 29),
			Size = UDim2.new(1, -70, 0, 22),
			BackgroundColor3 = theme.Surface3,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamBold,
			Text = colorToHex(value),
			TextColor3 = theme.Text,
			TextSize = 9,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 142,
			Parent = info,
		})
		addCorner(hexBox, 7)
		addPadding(hexBox, 8, 8, 0, 0)

		local function updateVisuals(fireCallback)
			local newColor = Color3.fromHSV(currentH, currentS, currentV)
			value = newColor

			preview.BackgroundColor3 = newColor
			hexLabel.Text = colorToHex(newColor)

			sv.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
			svCursor.Position = UDim2.fromScale(currentS, 1 - currentV)
			hueCursor.Position = UDim2.new(currentH, 0, 0.5, 0)

			livePreview.BackgroundColor3 = newColor
			hexBox.Text = colorToHex(newColor)

			local rgb = colorToTable(newColor)
			rgbText.Text = string.format(
				"RGB  %d, %d, %d",
				rgb.R,
				rgb.G,
				rgb.B
			)

			if fireCallback ~= false then
				safeCallback(options.Callback, newColor)
			end
		end

		local function updateSV(inputX, inputY)
			local size = sv.AbsoluteSize
			local pos = sv.AbsolutePosition

			currentS = math.clamp(
				(inputX - pos.X) / math.max(size.X, 1),
				0,
				1
			)

			currentV = 1 - math.clamp(
				(inputY - pos.Y) / math.max(size.Y, 1),
				0,
				1
			)

			updateVisuals(true)
		end

		local function updateHue(inputX)
			local size = hue.AbsoluteSize
			local pos = hue.AbsolutePosition

			currentH = math.clamp(
				(inputX - pos.X) / math.max(size.X, 1),
				0,
				1
			)

			updateVisuals(true)
		end

		pickerMaid:Give(sv.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				draggingSV = true
				updateSV(input.Position.X, input.Position.Y)
			end
		end))

		pickerMaid:Give(hue.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				draggingHue = true
				updateHue(input.Position.X)
			end
		end))

		pickerMaid:Give(UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			if draggingSV then
				updateSV(input.Position.X, input.Position.Y)
			elseif draggingHue then
				updateHue(input.Position.X)
			end
		end))

		pickerMaid:Give(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				draggingSV = false
				draggingHue = false
			end
		end))

		pickerMaid:Give(hexBox.FocusLost:Connect(function()
			local parsed = hexToColor(hexBox.Text)

			if not parsed then
				hexBox.Text = colorToHex(value)
				return
			end

			currentH, currentS, currentV = parsed:ToHSV()
			updateVisuals(true)
		end))

		pickerMaid:Give(closeButton.MouseButton1Click:Connect(function()
			window:_ClosePopup()
		end))

		local popupData = {
			Frame = popup,
			Connection = nil,
			Cleanup = pickerMaid,
		}

		window.ActivePopup = popupData

		task.defer(function()
			if window.ActivePopup ~= popupData then
				return
			end

			popupData.Connection = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseButton1
					and input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end

				local point = input.Position
				local popupPos = popup.AbsolutePosition
				local popupSize = popup.AbsoluteSize
				local anchorP = colorButton.AbsolutePosition
				local anchorS = colorButton.AbsoluteSize

				local insidePopup =
					point.X >= popupPos.X
					and point.X <= popupPos.X + popupSize.X
					and point.Y >= popupPos.Y
					and point.Y <= popupPos.Y + popupSize.Y

				local insideAnchor =
					point.X >= anchorP.X
					and point.X <= anchorP.X + anchorS.X
					and point.Y >= anchorP.Y
					and point.Y <= anchorP.Y + anchorS.Y

				if not insidePopup and not insideAnchor then
					window:_ClosePopup()
				end
			end)
		end)

		updateVisuals(false)

		tween(popup, 0.20, {
			Position = UDim2.fromOffset(x, y),
			GroupTransparency = 0,
		})

		tween(
			popupScale,
			0.26,
			{Scale = 1},
			Enum.EasingStyle.Back
		)
	end))

	self.Window:_RegisterControl(options.Id, controller)

	if options.FireOnLoad then
		safeCallback(options.Callback, value)
	end

	return controller
end

