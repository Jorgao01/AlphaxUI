function Window:BindAccent(callback)
	table.insert(self.AccentBindings, callback)

	pcall(function()
		callback(self.Theme.Accent)
	end)

	return callback
end

function Window:SetScale(scale)
	scale = tonumber(scale)

	if not scale then
		return false
	end

	self.InterfaceScale = math.clamp(scale, 0.65, 1.45)

	if self.WindowScale then
		tween(
			self.WindowScale,
			0.22,
			{Scale = self.InterfaceScale},
			Enum.EasingStyle.Quint
		)
	end

	return true
end

function Window:GetScale()
	return self.InterfaceScale
end

function Window:SetBranding(data)
	if type(data) ~= "table" then
		return false
	end

	if data.Title ~= nil then
		self.TitleLabel.Text = tostring(data.Title)
	end

	if data.Subtitle ~= nil then
		self.SubtitleLabel.Text = tostring(data.Subtitle)
	end

	return true
end

function Window:SetAccent(color)
	local converted = tableToColor(color) or color
	if typeof(converted) ~= "Color3" then
		return false
	end

	self.Theme.Accent = converted
	self.Theme.Accent2 = converted:Lerp(Color3.new(1, 1, 1), 0.20)

	for _, callback in ipairs(self.AccentBindings) do
		pcall(function()
			callback(converted)
		end)
	end

	return true
end

function Window:SetTitle(title, subtitle)
	if title ~= nil then
		self.TitleLabel.Text = tostring(title)
	end

	if subtitle ~= nil then
		self.SubtitleLabel.Text = tostring(subtitle)
	end
end

function Window:SetToggleKey(keyCode)
	if typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode then
		self.ToggleKey = keyCode

		if self.StatusKeyLabel then
			self.StatusKeyLabel.Text = keyCode.Name
		end

		return true
	end

	return false
end

