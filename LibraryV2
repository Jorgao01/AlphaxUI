--// ============================================================

function Section:AddProgress(options)
	options = options or {}

	local theme = self.Window.Theme
	local name = options.Name or "Progress"
	local description = options.Description or ""
	local value = math.clamp(tonumber(options.Default) or 0, 0, 100)

	local row = self:_CreateRow(
		description ~= "" and 96 or 82,
		name .. " " .. description
	)

	self:_CreateTextBlock(row, name, description, UDim2.new(1, -95, 0, 56))

	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 15),
		Size = UDim2.fromOffset(70, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(math.floor(value + 0.5)) .. "%",
		TextColor3 = theme.Accent2,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 10,
		Parent = row,
	})

	local track = create("Frame", {
		Position = UDim2.new(0, 16, 1, -24),
		Size = UDim2.new(1, -32, 0, 8),
		BackgroundColor3 = theme.Surface4,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(track, 4)

	local fill = create("Frame", {
		Size = UDim2.new(value / 100, 0, 1, 0),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = track,
	})

	addCorner(fill, 4)
	local fillGradient = addGradient(fill, theme.Accent2, theme.Accent, 0)

	self.Window:BindAccent(function(accent)
		fill.BackgroundColor3 = accent
		valueLabel.TextColor3 = self.Window.Theme.Accent2
		fillGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, self.Window.Theme.Accent2),
			ColorSequenceKeypoint.new(1, accent),
		})
	end)

	local controller = {}

	function controller:Set(newValue, fireCallback)
		local numeric = math.clamp(tonumber(newValue) or 0, 0, 100)
		value = numeric

		tween(fill, 0.18, {
			Size = UDim2.new(value / 100, 0, 1, 0),
		})

		valueLabel.Text = tostring(math.floor(value + 0.5)) .. "%"

		if fireCallback ~= false then
			safeCallback(options.Callback, value)
		end
	end

	function controller:Get()
		return value
	end

	self.Window:_RegisterControl(options.Id, controller)
	return controller
end

