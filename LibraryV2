function Section:AddKeybind(options)
	options = options or {}

	local theme = self.Window.Theme
	local name = options.Name or "Keybind"
	local description = options.Description or ""

	local currentKey = options.Default or Enum.KeyCode.Unknown
	local listening = false

	local row = self:_CreateRow(
		description ~= "" and 72 or 58,
		name .. " " .. description
	)

	self:_CreateTextBlock(row, name, description, UDim2.new(1, -125, 1, 0))

	local keyButton = create("TextButton", {
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(92, 38),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = currentKey.Name,
		TextColor3 = theme.Text,
		TextSize = 10,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(keyButton, 10)
	local keyStroke = addStroke(keyButton, theme.Stroke, 0.35, 1)

	local controller = {}

	function controller:Set(newKey, fireCallback)
		local resolved = nil

		if typeof(newKey) == "EnumItem" and newKey.EnumType == Enum.KeyCode then
			resolved = newKey
		elseif type(newKey) == "string" then
			local ok, enumValue = pcall(function()
				return Enum.KeyCode[newKey]
			end)

			if ok then
				resolved = enumValue
			end
		end

		if not resolved then
			return
		end

		currentKey = resolved
		keyButton.Text = currentKey.Name

		if fireCallback ~= false then
			safeCallback(options.Changed, currentKey)
		end
	end

	function controller:Get()
		return currentKey.Name
	end

	self.Window.Maid:Give(keyButton.MouseButton1Click:Connect(function()
		listening = true
		keyButton.Text = "..."
		keyStroke.Color = theme.Accent
	end))

	self.Window.Maid:Give(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening then
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				listening = false
				keyStroke.Color = theme.Stroke
				controller:Set(input.KeyCode, true)
			end

			return
		end

		if not gameProcessed
			and currentKey ~= Enum.KeyCode.Unknown
			and input.KeyCode == currentKey then

			safeCallback(options.Callback, currentKey)
		end
	end))

	self.Window:_RegisterControl(options.Id, controller)

	return controller
end

