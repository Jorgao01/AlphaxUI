	local cancelScale = create("UIScale", {Scale = 1, Parent = cancel})

	local confirm = create("TextButton", {
		AutoButtonColor = false,
		Size = UDim2.fromOffset(buttonWidth, 42),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = tostring(options.ConfirmText or "Confirmar"),
		TextColor3 = accentText,
		TextSize = 10,
		ZIndex = 304,
		Parent = actions,
	})
	addCorner(confirm, 13)
	local confirmStroke = addStroke(confirm, accent2, 0.06, 1)
	addGradient(confirm, accent2, accent, 0)

	local confirmScale = create("UIScale", {Scale = 1, Parent = confirm})

	local closed = false
	local interactionsEnabled = true

	local function hoverButton(button, scaleObject, entering, isAccent)
		if not button or not button.Parent or not interactionsEnabled then
			return
		end

		tween(
			scaleObject,
			0.13,
			{Scale = entering and 1.035 or 1},
			Enum.EasingStyle.Quint
		)

		if not isAccent then
			tween(button, 0.13, {
				BackgroundColor3 = entering and theme.Surface4 or theme.Surface3,
			})
		end
	end

	local function pressButton(scaleObject)
		if not interactionsEnabled then
			return
		end

		tween(
			scaleObject,
			0.065,
			{Scale = 0.95},
			Enum.EasingStyle.Quint
		)

		task.delay(0.07, function()
			if scaleObject and scaleObject.Parent and interactionsEnabled then
				tween(
					scaleObject,
					0.11,
					{Scale = 1.035},
					Enum.EasingStyle.Back
				)
			end
		end)
	end

	local function closeModal(callback, accepted)
		if closed then
			return
		end

		closed = true
		interactionsEnabled = false

		cancel.Active = false
		confirm.Active = false
		shade.Active = false

		-- Pequena reação inicial antes de sumir.
		if accepted then
			tween(
				confirmScale,
				0.08,
				{Scale = 1.07},
				Enum.EasingStyle.Back
			)
		end

		-- Icon é recolhido primeiro.
		tween(
			iconScale,
			0.14,
			{Scale = 0.45},
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		)

		-- O modal sobe alguns pixels, encolhe e desaparece como uma unidade.
		tween(
			modal,
			0.24,
			{
				Position = UDim2.new(0.5, 0, 0.5, -8),
				GroupTransparency = 1,
			},
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)

		tween(
			modalScale,
			0.24,
			{Scale = 0.84},
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		)

		tween(
			shadow,
			0.22,
			{
				Position = UDim2.new(0.5, 0, 0.5, 20),
				BackgroundTransparency = 1,
			},
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)

		tween(
			shadowScale,
			0.22,
			{Scale = 0.86},
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)

		tween(shade, 0.26, {
			BackgroundTransparency = 1,
		})

		task.delay(0.255, function()
			if self.ModalLayer then
				self.ModalLayer.Visible = false

				for _, child in ipairs(self.ModalLayer:GetChildren()) do
					child:Destroy()
				end
			end

			safeCallback(callback)
		end)
	end

	self.Maid:Give(cancel.MouseEnter:Connect(function()
		hoverButton(cancel, cancelScale, true, false)
		cancelStroke.Transparency = 0.14
	end))

	self.Maid:Give(cancel.MouseLeave:Connect(function()
		hoverButton(cancel, cancelScale, false, false)
		cancelStroke.Transparency = 0.34
	end))

	self.Maid:Give(confirm.MouseEnter:Connect(function()
		hoverButton(confirm, confirmScale, true, true)
		confirmStroke.Transparency = 0
	end))

	self.Maid:Give(confirm.MouseLeave:Connect(function()
		hoverButton(confirm, confirmScale, false, true)
		confirmStroke.Transparency = 0.06
	end))

	self.Maid:Give(cancel.MouseButton1Down:Connect(function()
		pressButton(cancelScale)
	end))

	self.Maid:Give(confirm.MouseButton1Down:Connect(function()
		pressButton(confirmScale)
	end))

	self.Maid:Give(cancel.MouseButton1Click:Connect(function()
		closeModal(options.OnCancel, false)
	end))

	self.Maid:Give(confirm.MouseButton1Click:Connect(function()
		closeModal(options.OnConfirm, true)
	end))

	self.Maid:Give(shade.MouseButton1Click:Connect(function()
		closeModal(options.OnCancel, false)
	end))

	-- Entrada: fade de fundo, modal sobe e cresce com overshoot.
	tween(shade, 0.20, {
		BackgroundTransparency = 0.38,
	})

	tween(
		shadow,
		0.30,
		{
			Position = UDim2.new(0.5, 0, 0.5, 10),
			BackgroundTransparency = 0.68,
		},
		Enum.EasingStyle.Quint
	)

	tween(
		shadowScale,
		0.34,
		{Scale = 1},
		Enum.EasingStyle.Back
	)

	tween(
		modal,
		0.28,
		{
			Position = UDim2.fromScale(0.5, 0.5),
			GroupTransparency = 0,
		},
		Enum.EasingStyle.Quint
	)

	tween(
		modalScale,
		0.38,
		{Scale = 1},
		Enum.EasingStyle.Back
	)

	task.delay(0.08, function()
		if iconScale and iconScale.Parent then
			tween(
				iconScale,
				0.31,
				{Scale = 1},
				Enum.EasingStyle.Back
			)
		end
	end)

	return modal
end


