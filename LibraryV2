function Window:RegisterAccent(instance: Instance, property: string)
	table.insert(self.AccentObjects, {
		Instance = instance,
		Property = property,
	})
end

function Window:SetAccent(color: Color3)
	self.Theme.Accent = color
	for _, entry in ipairs(self.AccentObjects) do
		if entry.Instance and entry.Instance.Parent then
			pcall(function()
				(entry.Instance :: any)[entry.Property] = color
			end)
		end
	end
end

function Window:SetToggleKey(keyCode: Enum.KeyCode)
	self.ToggleKey = keyCode
end

function Window:SetMinimized(state: boolean)
	if self._destroyed then return end
	self.Minimized = state

	if state then
		tween(self.Root, 0.24, {Size = UDim2.new(self.Root.Size.X.Scale, self.Root.Size.X.Offset, 0, 58)})
	else
		tween(self.Root, 0.24, {Size = self.ExpandedSize})
	end
end

function Window:Toggle()
	if self._destroyed then return end
	self.Visible = not self.Visible
	self.Gui.Enabled = self.Visible
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self.Maid:Clean()
end

function Window:_applySearch(query: string)
	local q = normalizeName(query)
	for _, entry in ipairs(self.Searchables) do
		local visible = q == "" or string.find(entry.SearchText, q, 1, true) ~= nil
		if entry.Instance and entry.Instance.Parent then
			entry.Instance.Visible = visible
		end
	end
end

function Window:_registerSearchable(instance: GuiObject, text: string)
	table.insert(self.Searchables, {
		Instance = instance,
		SearchText = normalizeName(text),
	})
end

function Window:_registerControl(id, controller)
	if not id then
		return
	end
	self.Controls[id] = controller
end

function Window:GetConfig()
	local data = {}
	for id, controller in pairs(self.Controls) do
		if controller.Get then
			local ok, value = pcall(function()
				return controller:Get()
			end)
			if ok then
				data[id] = value
			end
		end
	end
	return HttpService:JSONEncode(data)
end

function Window:LoadConfig(jsonString: string, fireCallbacks: boolean?)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(jsonString)
	end)
	if not ok or type(data) ~= "table" then
		return false, "JSON inválido"
	end

	for id, value in pairs(data) do
		local controller = self.Controls[id]
		if controller and controller.Set then
			pcall(function()
				controller:Set(value, fireCallbacks == true)
			end)
		end
	end

	return true
end

function Window:Notify(options)
	options = options or {}
	local theme = self.Theme
	local duration = tonumber(options.Duration) or 4
	local accent = options.Color or theme.Accent

	local card = new("Frame", {
		Size = UDim2.fromOffset(310, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Surface,
		BackgroundTransparency = 0.02,
		BorderSizePixel = 0,
		Parent = self.NotificationHolder,
	})
	corner(card, 12)
	stroke(card, theme.Stroke, 0.25, 1)
	padding(card, 14, 14, 13, 13)

	local indicator = new("Frame", {
		Position = UDim2.fromOffset(-14, 0),
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = card,
	})
	corner(indicator, 2)

	new("UIListLayout", {
		Padding = UDim.new(0, 5),
		Parent = card,
	})

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = options.Title or "Notificação",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = options.Content or "",
		TextColor3 = theme.Muted,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})

	card.Position = UDim2.fromOffset(30, 0)
	card.BackgroundTransparency = 1
	for _, d in ipairs(card:GetDescendants()) do
		if d:IsA("TextLabel") then
			d.TextTransparency = 1
		end
	end

	tween(card, 0.22, {Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 0.02})
	for _, d in ipairs(card:GetDescendants()) do
		if d:IsA("TextLabel") then
			tween(d, 0.22, {TextTransparency = 0})
		end
	end

	task.delay(duration, function()
		if not card.Parent then return end
		tween(card, 0.22, {Position = UDim2.fromOffset(25, 0), BackgroundTransparency = 1})
		for _, d in ipairs(card:GetDescendants()) do
			if d:IsA("TextLabel") then
				tween(d, 0.18, {TextTransparency = 1})
			end
		end
		task.delay(0.24, function()
