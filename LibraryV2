function Section:AddSlider(options)
	options = options or {}
	local theme = self.Window.Theme
	local min = tonumber(options.Min) or 0
	local max = tonumber(options.Max) or 100
	local increment = tonumber(options.Increment) or 1
	local decimals = tonumber(options.Decimals) or (increment < 1 and 2 or 0)
	local value = math.clamp(tonumber(options.Default) or min, min, max)

	local row = self:_row(64, options.Name or "Slider")

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -90, 0, 20),
		Font = Enum.Font.GothamMedium,
		Text = options.Name or "Slider",
		TextColor3 = theme.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valueLabel = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(70, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = formatNumber(value, decimals),
		TextColor3 = theme.Muted,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local bar = new("Frame", {
		Position = UDim2.fromOffset(12, 39),
		Size = UDim2.new(1, -24, 0, 7),
		BackgroundColor3 = theme.Surface3,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(bar, 4)

	local fill = new("Frame", {
		Size = UDim2.new((value - min) / math.max(max - min, 0.0001), 0, 1, 0),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(fill, 4)
	self.Window:RegisterAccent(fill, "BackgroundColor3")

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new((value - min) / math.max(max - min, 0.0001), 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(knob, 7)
	stroke(knob, theme.Accent, 0.15, 2)

	local dragging = false
	local controller = {}

	local function snap(raw)
		local snapped = math.floor((raw - min) / increment + 0.5) * increment + min
		return math.clamp(snapped, min, max)
	end

	function controller:Set(newValue, fireCallback)
		newValue = snap(tonumber(newValue) or min)
		value = newValue
		local alpha = (value - min) / math.max(max - min, 0.0001)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = formatNumber(value, decimals)
		if fireCallback ~= false then
			safeCallback(options.Callback, value)
		end
	end

	function controller:Get()
		return value
	end

	local function updateFromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		controller:Set(min + (max - min) * alpha, true)
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromX(input.Position.X)
		end
	end)

	self.Window.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end))

	self.Window.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	self.Window:_registerControl(options.Id, controller)
	return controller
end

