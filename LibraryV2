		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 206,
		Parent = card,
	})

	local scale = create("UIScale", {
		Scale = 0.97,
		Parent = card,
	})

	tween(card, 0.18, {
		BackgroundTransparency = 0.02,
	})

	tween(title, 0.18, {
		TextTransparency = 0,
	})

	tween(content, 0.18, {
		TextTransparency = 0,
	})

	tween(scale, 0.18, {
		Scale = 1,
	})

	task.delay(duration, function()
		if not card or not card.Parent then
			return
		end

		tween(card, 0.16, {
			BackgroundTransparency = 1,
		})

		tween(title, 0.14, {
			TextTransparency = 1,
		})

		tween(content, 0.14, {
			TextTransparency = 1,
		})

		tween(scale, 0.16, {
			Scale = 0.97,
