		ZIndex = 11,
		Parent = switch,
	})

	addCorner(knob, 14)
	addStroke(knob, Color3.fromRGB(255, 255, 255), 0.45, 1)

	local hit = create("TextButton", {
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 12,
		Parent = row,
	})

	local switchScale = create("UIScale", {
		Scale = 1,
		Parent = switch,
	})

	local controller = {}

	self.Window.Maid:Give(hit.MouseEnter:Connect(function()
		tween(
			switchScale,
			0.14,
			{
				Scale = 1.05,
			},
			Enum.EasingStyle.Quint
		)

		if value then
			tween(switchGlow, 0.14, {
				BackgroundTransparency = 0.68,
			})
		end
	end))

