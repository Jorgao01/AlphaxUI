		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(53, 0),
		Size = UDim2.new(1, -66, 1, 0),
		Font = Enum.Font.GothamBold,
		Text = tab.Name,
		TextColor3 = theme.Muted,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 7,
		Parent = button,
	})

	tab.Icon = icon
	tab.Label = label
	tab.ActiveBar = activeBar
	tab.IconGlow = iconGlow

	local page = create("ScrollingFrame", {
		Name = tab.Name .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		ZIndex = 5,
		Parent = self.PageContainer,
	})

	tab.Page = page

	create("UIListLayout", {
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page,
	})

	addPadding(page, 32, 32, 4, 26)

	self:BindAccent(function(accent)
		page.ScrollBarImageColor3 = accent
	end)

	tab.Maid:Give(button.MouseEnter:Connect(function()
		if self.ActiveTab ~= tab then
			tween(button, 0.14, {
				BackgroundTransparency = 0.55,
				BackgroundColor3 = theme.Surface2,
			})
		end
	end))

	tab.Maid:Give(button.MouseLeave:Connect(function()
		if self.ActiveTab ~= tab then
			tween(button, 0.14, {
				BackgroundTransparency = 1,
			})
		end
	end))

	tab.Maid:Give(button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end))

	table.insert(self.Tabs, tab)

	if not self.ActiveTab then
		self:SelectTab(tab)
	end

	return tab
end

function Window:SelectTab(tab)
	if self.Destroyed or not tab then
		return
	end

	self:_ClosePopup()

	for _, current in ipairs(self.Tabs) do
		local active = current == tab

		current.Page.Visible = active

		tween(current.Button, 0.16, {
			BackgroundTransparency = active and 0 or 1,
			BackgroundColor3 = active and self.Theme.Surface2 or self.Theme.Surface,
		})

		tween(current.Label, 0.16, {
			TextColor3 = active and self.Theme.Text or self.Theme.Muted,
		})

		tween(current.Icon, 0.16, {
			TextColor3 = active and self.Theme.Accent or self.Theme.Muted,
		})

		tween(current.ActiveBar, 0.16, {
			BackgroundTransparency = active and 0 or 1,
		})

		tween(current.IconGlow, 0.16, {
			BackgroundTransparency = active and 0.76 or 1,
		})

		current.ButtonStroke.Transparency = active and 0.42 or 1
	end

	self.ActiveTab = tab
	self.PageTitle.Text = tab.Name
	self.PageDescription.Text = tab.Description

	if self.SearchBox.Text ~= "" then
		self:_ApplySearch(self.SearchBox.Text)
	end
end

