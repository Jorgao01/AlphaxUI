	addCorner(shine, 5)

	local footer = create("TextLabel", {
		Position = UDim2.fromOffset(12, 48),
		Size = UDim2.new(1, -24, 0, 12),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "Preparando a interface para uso",
		TextColor3 = theme.Faint,
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 504,
		Parent = progressBox,
	})

	-- On narrow mobile, keep structure but reduce height pressure.
	if viewport.X <= 470 then
		moduleRow.Position = UDim2.fromOffset(18, 84)
		progressBox.Position = UDim2.fromOffset(18, 166)
	end

	-- Slower, more intentional appearance.
	tween(
		loader,
		0.55 * self.AnimationSpeed,
		{GroupTransparency = 0},
		Enum.EasingStyle.Quint
	)

	tween(
		shadow,
		0.65 * self.AnimationSpeed,
		{Position = UDim2.new(0.5, 0, 0.5, 9)},
		Enum.EasingStyle.Quint
	)

	tween(
		card,
		0.68 * self.AnimationSpeed,
		{Position = UDim2.fromScale(0.5, 0.5)},
		Enum.EasingStyle.Quint
	)

	tween(
		cardScale,
		0.72 * self.AnimationSpeed,
		{Scale = 1},
		Enum.EasingStyle.Back
	)

	-- Progress starts only after most of the entrance is visible.
	local started = os.clock() + (0.45 * self.AnimationSpeed)
	local duration = self.LoadingDuration
	local connection

	connection = RunService.RenderStepped:Connect(function(deltaTime)
		if not loader.Parent then
			if connection then
				connection:Disconnect()
			end
			return
		end

		local elapsed = math.max(0, os.clock() - started)
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local eased = 1 - ((1 - alpha) ^ 3)

		local pulse = 0.5 + (math.sin(os.clock() * 3.1) * 0.5)

		-- Subtle motion, not exaggerated glow/orbits.
		logoScale.Scale = 0.99 + (pulse * 0.02)
		ambient.BackgroundTransparency = 0.972 - (pulse * 0.012)
		cardStroke.Transparency = 0.22 - (pulse * 0.035)

		progress.Size = UDim2.new(eased, 0, 1, 0)
		shine.Position = UDim2.fromOffset(
			math.floor((progress.AbsoluteSize.X + 30) * pulse) - 30,
			0
		)

		local percent = math.floor(eased * 100 + 0.5)
		percentLabel.Text = tostring(percent) .. "%"

		local stageCount = #moduleCards
		local stageIndex = math.clamp(
			math.ceil(eased * stageCount),
			1,
			stageCount
		)

		stageLabel.Text = "Inicializando " .. moduleNames[stageIndex]

		for index, data in ipairs(moduleCards) do
			local reached = index <= stageIndex

			data.Card.BackgroundColor3 = reached and theme.Surface3 or theme.Surface2
			data.Stroke.Color = reached and theme.Accent or theme.StrokeSoft
			data.Stroke.Transparency = reached and 0.56 or 0.32

			setVectorIconColor(
				data.Icon,
				reached and theme.Accent or theme.Faint
			)

			data.Label.TextColor3 = reached and theme.Text or theme.Faint
		end

		if alpha >= 1 then
			connection:Disconnect()

			percentLabel.Text = "100%"
			stageLabel.Text = "Interface pronta"
			subtitle.Text = self.LoadingDoneText
			footer.Text = "Concluído"

			for _, data in ipairs(moduleCards) do
				data.Card.BackgroundColor3 = theme.Surface3
				data.Stroke.Color = theme.Accent
				data.Stroke.Transparency = 0.50
				setVectorIconColor(data.Icon, theme.Accent)
				data.Label.TextColor3 = theme.Text
			end

			tween(
				logoScale,
				0.22 * self.AnimationSpeed,
				{Scale = 1.05},
				Enum.EasingStyle.Back
			)

			-- Small completion hold before disappearing.
			task.delay(0.32 * self.AnimationSpeed, function()
				if not loader.Parent or self.Destroyed then
					return
				end

				-- Slower disappearance.
				tween(
					cardScale,
					0.60 * self.AnimationSpeed,
					{Scale = 0.96},
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.In
				)

				tween(
					card,
					0.62 * self.AnimationSpeed,
					{
						Position = UDim2.new(0.5, 0, 0.5, -10),
						GroupTransparency = 1,
					},
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.In
				)

				tween(
					shadow,
					0.58 * self.AnimationSpeed,
					{
						Position = UDim2.new(0.5, 0, 0.5, 17),
						BackgroundTransparency = 1,
					},
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.In
				)

				tween(
					loader,
					0.68 * self.AnimationSpeed,
					{GroupTransparency = 1},
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.In
				)

				task.delay(0.72 * self.AnimationSpeed, function()
					if loader and loader.Parent then
						loader:Destroy()
					end

					if self.Destroyed then
						return
					end

					self.Chrome.Visible = true
					self.Chrome.GroupTransparency = 1

					if self.BlurEffect then
						tween(
							self.BlurEffect,
							0.50,
							{Size = self.BlurSize},
							Enum.EasingStyle.Quint
						)
					end

					local safePosition = clampWindowPosition(
						self.Chrome,
						self.Chrome.Position,
						self.Chrome.Size,
						self.MobileMode and 6 or 10
					)

					self.Chrome.Position = UDim2.new(
						safePosition.X.Scale,
						safePosition.X.Offset,
						safePosition.Y.Scale,
						safePosition.Y.Offset + 10
					)

					if self.Root and self.Root:IsA("CanvasGroup") then
						self.Root.GroupTransparency = 0
					end

					if self.WindowScale then
						self.WindowScale.Scale = 0.95 * self.InterfaceScale
					end

					tween(
						self.Chrome,
						0.50 * self.AnimationSpeed,
						{
							Position = safePosition,
							GroupTransparency = 0,
						},
						Enum.EasingStyle.Quint
					)

					if self.WindowScale then
						tween(
							self.WindowScale,
							0.54 * self.AnimationSpeed,
							{Scale = self.InterfaceScale},
							Enum.EasingStyle.Back
						)
					end
				end)
			end)
		end
	end)
end


function Window:SetMobileSidebar(state)
	if self.Destroyed or not self.MobileMode then
		return
	end

	state = state == true
	self.MobileSidebarOpen = state

	local sidebar = self.Sidebar
	local shade = self.MobileSidebarShade

	if not sidebar or not shade then
		return
	end

	if state then
		shade.Visible = true

		tween(shade, 0.20, {
			BackgroundTransparency = 0.48,
		})

		tween(
			sidebar,
			0.28,
			{
				Position = UDim2.fromOffset(6, 4),
			},
			Enum.EasingStyle.Quint
		)
	else
		tween(shade, 0.18, {
			BackgroundTransparency = 1,
		})

		tween(
			sidebar,
			0.24,
			{
				Position = UDim2.fromOffset(-270, 4),
			},
			Enum.EasingStyle.Quint
		)

		task.delay(0.19, function()
			if not self.MobileSidebarOpen and shade and shade.Parent then
				shade.Visible = false
			end
		end)
	end
end

function Window:ToggleMobileSidebar()
	if not self.MobileMode then
		return
	end

	self:SetMobileSidebar(not self.MobileSidebarOpen)
end

function Window:_ClampToViewport(sizeOverride, animated)
	if self.Destroyed or not self.Chrome then
		return
	end

	local targetPosition = clampWindowPosition(
		self.Chrome,
		self.Chrome.Position,
		sizeOverride or self.Chrome.Size,
		10
	)

	if animated then
		tween(
			self.Chrome,
			0.24,
			{
				Position = targetPosition,
			},
			Enum.EasingStyle.Quint
		)
	else
		self.Chrome.Position = targetPosition
	end
end

function Window:SetMinimized(state)
	if self.Destroyed then
		return
	end

	self.Minimized = state == true
	self:_ClosePopup()

	local targetSize

	if self.Minimized then
		if self.MobileMode then
			targetSize = UDim2.new(1, -14, 0, 79)
		else
			targetSize = self.MinimizedSize
		end
	else
		if self.MobileMode then
			targetSize = UDim2.new(1, -14, 1, -22)
		else
			targetSize = self.ExpandedSize
		end
	end

	-- ESSENCIAL:
	-- usa o tamanho FINAL para calcular onde a janela pode ficar.
	-- Assim, se ela foi arrastada para o topo enquanto minimizada,
	-- ao restaurar ela volta automaticamente para uma posição segura.
	local safePosition = clampWindowPosition(
		self.Chrome,
		self.Chrome.Position,
		targetSize,
		10
	)

	if not self.Minimized then
		self.Body.Visible = true
	end

	if self.BodyScale then
		tween(
			self.BodyScale,
			self.Minimized and 0.14 or 0.24,
			{
				Scale = self.Minimized and 0.985 or 1,
			},
			self.Minimized and Enum.EasingStyle.Quint or Enum.EasingStyle.Back
		)
	end

	tween(
		self.Chrome,
		self.Minimized and 0.22 or 0.30,
		{
			Size = targetSize,
			Position = safePosition,
		},
		self.Minimized and Enum.EasingStyle.Quint or Enum.EasingStyle.Quint
	)

	if self.WindowScale then
		tween(
			self.WindowScale,
			0.20,
			{
				Scale = (self.Minimized and 0.992 or 1) * self.InterfaceScale,
			},
			Enum.EasingStyle.Quint
		)
	end

	if self.Minimized then
		task.delay(0.23, function()
			if self.Minimized and self.Body then
				self.Body.Visible = false
			end
		end)
	end
end

function Window:_AcquireVisibilityLock()
	if self.Destroyed or self.VisibilityTransitionLocked then
		return false
	end

	self.VisibilityTransitionLocked = true

	task.delay(self.VisibilityCooldown, function()
		if not self.Destroyed then
			self.VisibilityTransitionLocked = false
		end
	end)

	return true
end

function Window:SetVisible(state, force)
	if self.Destroyed or self.Closing then
		return false
	end

	state = state == true

	if state == self.Visible and not force then
		return false
	end

	if not force and not self:_AcquireVisibilityLock() then
		return false
	end

	self.Visible = state

	local root = self.Root
	local chrome = self.Chrome
	local scale = self.WindowScale
	local dim = self.Dim
	local blur = self.BlurEffect

	if state then
		self.Gui.Enabled = true

		local safePosition = clampWindowPosition(
			chrome,
			chrome.Position,
			chrome.Size,
			self.MobileMode and 6 or 10
		)

		chrome.GroupTransparency = 1
		chrome.Position = UDim2.new(
			safePosition.X.Scale,
			safePosition.X.Offset,
			safePosition.Y.Scale,
			safePosition.Y.Offset + 10
		)

		if root and root:IsA("CanvasGroup") then
			root.GroupTransparency = 0
		end

		if scale then
			scale.Scale = 0.95 * self.InterfaceScale
		end

		if dim then
			dim.BackgroundTransparency = 1
		end

		if blur then
			blur.Enabled = true
			blur.Size = 0
		end

		-- Whole chrome enters together, including borders/glow.
		tween(
			chrome,
			0.46,
			{
				Position = safePosition,
				GroupTransparency = 0,
			},
			Enum.EasingStyle.Quint
		)

		if scale then
			tween(
				scale,
				0.50,
				{Scale = self.InterfaceScale},
				Enum.EasingStyle.Back
			)
		end

		if dim then
			tween(dim, 0.44, {
				BackgroundTransparency = self.DimTransparency or 0.72,
			})
		end

		if blur then
			tween(blur, 0.44, {
				Size = self.BlurSize,
			})
		end

	else
		self:_ClosePopup()

		if self.MobileMode then
			self:SetMobileSidebar(false)
		end

		tween(
			chrome,
			0.44,
			{
				Position = UDim2.new(
					chrome.Position.X.Scale,
					chrome.Position.X.Offset,
					chrome.Position.Y.Scale,
					chrome.Position.Y.Offset + 10
				),
				GroupTransparency = 1,
			},
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)

		if scale then
			tween(
				scale,
				0.44,
				{Scale = 0.95 * self.InterfaceScale},
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.In
			)
		end

		if dim then
			tween(dim, 0.42, {
				BackgroundTransparency = 1,
			})
		end

		if blur then
			tween(blur, 0.42, {
				Size = 0,
			})
		end

		task.delay(0.48, function()
			if not self.Destroyed and not self.Visible then
				self.Gui.Enabled = false

				local current = clampWindowPosition(
					chrome,
					chrome.Position,
					chrome.Size,
					self.MobileMode and 6 or 10
				)

				chrome.Position = UDim2.new(
					current.X.Scale,
					current.X.Offset,
					current.Y.Scale,
					current.Y.Offset - 10
				)

				chrome.GroupTransparency = 0
			end
		end)
	end

	return true
end

function Window:Toggle()
	if self.Destroyed or self.Closing then
		return false
	end

	return self:SetVisible(not self.Visible)
end

function Window:Close()
	if self.Destroyed or self.Closing then
		return false
	end

	if not self:_AcquireVisibilityLock() then
		return false
	end

	self.Closing = true
	self.Visible = false
	self:_ClosePopup()

	if self.MobileMode then
		self:SetMobileSidebar(false)
	end

	local chrome = self.Chrome
	local scale = self.WindowScale
	local dim = self.Dim
	local blur = self.BlurEffect

	-- Fade the complete Chrome CanvasGroup.
	-- This includes outer glow, borders and top accent line.
	if chrome then
		tween(
			chrome,
			0.52,
			{
				Position = UDim2.new(
					chrome.Position.X.Scale,
					chrome.Position.X.Offset,
					chrome.Position.Y.Scale,
					chrome.Position.Y.Offset + 14
				),
				GroupTransparency = 1,
			},
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)
	end

	if scale then
		tween(
			scale,
			0.52,
			{Scale = 0.90 * self.InterfaceScale},
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		)
	end

	if dim then
		tween(dim, 0.50, {
			BackgroundTransparency = 1,
		})
	end

	if blur then
		tween(blur, 0.50, {
			Size = 0,
		})
	end

	task.delay(0.56, function()
		if not self.Destroyed then
			self:Destroy()
		end
	end)

	return true
end

function Window:Destroy()
	if self.Destroyed then
		return
	end

	self.Destroyed = true
	self:_ClosePopup()
	self.Maid:Clean()
end

function Window:_RegisterControl(id, controller)
	if id == nil or id == "" then
		return
	end

	self.Controls[tostring(id)] = controller
end

function Window:_RegisterSearchable(instance, text, section)
	table.insert(self.Searchables, {
		Instance = instance,
		Text = normalize(text),
		Section = section,
	})
end

function Window:_ApplySearch(query)
	local normalizedQuery = normalize(query)

	for _, item in ipairs(self.Searchables) do
		if item.Instance and item.Instance.Parent then
			local visible = normalizedQuery == ""
				or string.find(item.Text, normalizedQuery, 1, true) ~= nil

			item.Instance.Visible = visible
		end
	end

	-- Hide sections with no visible controls while searching.
	for _, tab in ipairs(self.Tabs) do
		for _, section in ipairs(tab.Sections) do
			if normalizedQuery == "" then
				section.Frame.Visible = true
			else
				local foundVisible = false

				for _, control in ipairs(section.Controls) do
					if control.Parent and control.Visible then
						foundVisible = true
						break
					end
				end

				section.Frame.Visible = foundVisible
			end
		end
	end
end

function Window:GetConfigTable()
	local data = {}

	for id, controller in pairs(self.Controls) do
		if type(controller.Get) == "function" then
			local ok, value = pcall(function()
				return controller:Get()
			end)

			if ok then
				data[id] = value
			end
		end
	end

	return data
end

function Window:GetConfig()
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(self:GetConfigTable())
	end)

	if not ok then
		return nil, encoded
	end

	return encoded
end

function Window:LoadConfig(jsonOrTable, fireCallbacks)
	local data = jsonOrTable

	if type(jsonOrTable) == "string" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(jsonOrTable)
		end)

		if not ok then
			return false, decoded
		end

		data = decoded
	end

	if type(data) ~= "table" then
		return false, "Config precisa ser uma tabela ou JSON válido."
	end

	for id, value in pairs(data) do
		local controller = self.Controls[tostring(id)]

		if controller and type(controller.Set) == "function" then
			pcall(function()
				controller:Set(value, fireCallbacks == true)
			end)
		end
	end

	return true
end

function Window:_ClosePopup()
	if self.ActivePopup then
		local popup = self.ActivePopup

		self.ActivePopup = nil

		if popup.Connection then
			pcall(function()
				popup.Connection:Disconnect()
			end)
		end

		if popup.Cleanup then
			pcall(function()
				popup.Cleanup:Clean()
			end)
		end

		if popup.Frame and popup.Frame.Parent then
			popup.Frame:Destroy()
		end
	end
end

function Window:_OpenMenu(anchor, items, onSelect, options)
	options = options or {}
	self:_ClosePopup()

	if not anchor or not anchor.Parent then
		return
	end

	local theme = self.Theme
	local absPos = anchor.AbsolutePosition
	local absSize = anchor.AbsoluteSize

	local width = options.Width or math.max(absSize.X, 210)
	local visibleCount = math.min(#items, options.MaxVisible or 6)
	local height = math.max(44, visibleCount * 38 + 12)

	local viewport = self.PopupLayer.AbsoluteSize
	local x = absPos.X
	local y = absPos.Y + absSize.Y + 7

	if x + width > viewport.X - 12 then
		x = math.max(12, viewport.X - width - 12)
	end

	if y + height > viewport.Y - 12 then
		y = math.max(12, absPos.Y - height - 7)
	end

	local popup = create("Frame", {
		Name = "Popup",
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 120,
		Parent = self.PopupLayer,
	})

	addCorner(popup, 12)
	addStroke(popup, theme.Accent, 0.28, 1)

	local shadow = create("Frame", {
		Position = UDim2.fromOffset(-3, -3),
		Size = UDim2.new(1, 6, 1, 6),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 119,
		Parent = popup,
	})
	addCorner(shadow, 14)

	local scroll = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = theme.Accent,
		ZIndex = 121,
		Parent = popup,
	})

	create("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})

	addPadding(scroll, 6, 6, 6, 6)

	for index, item in ipairs(items) do
		local itemText
		local selected = false

		if type(item) == "table" then
			itemText = tostring(item.Text or item.Name or item.Value or index)
			selected = item.Selected == true
		else
			itemText = tostring(item)
		end

		local button = create("TextButton", {
			AutoButtonColor = false,
			Size = UDim2.new(1, -4, 0, 33),
			BackgroundColor3 = selected and theme.Surface4 or theme.Surface2,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamMedium,
			Text = itemText,
			TextColor3 = selected and theme.Text or theme.Muted,
			TextSize = 11,
			ZIndex = 122,
			Parent = scroll,
		})

		addCorner(button, 8)

		if selected then
			addStroke(button, theme.Accent, 0.3, 1)
		end

		self.Maid:Give(button.MouseEnter:Connect(function()
			tween(button, 0.12, {
				BackgroundColor3 = theme.Surface4,
				TextColor3 = theme.Text,
			})
		end))

		self.Maid:Give(button.MouseLeave:Connect(function()
			tween(button, 0.12, {
				BackgroundColor3 = selected and theme.Surface4 or theme.Surface2,
				TextColor3 = selected and theme.Text or theme.Muted,
			})
		end))

		self.Maid:Give(button.MouseButton1Click:Connect(function()
			onSelect(item, index)

			if options.KeepOpen ~= true then
				self:_ClosePopup()
			end
		end))
	end

	local popupData = {
		Frame = popup,
		Connection = nil,
	}

	self.ActivePopup = popupData

	task.defer(function()
		if self.ActivePopup ~= popupData then
			return
		end

		popupData.Connection = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			local point = input.Position
			local popupPos = popup.AbsolutePosition
			local popupSize = popup.AbsoluteSize
			local anchorPos = anchor.AbsolutePosition
			local anchorSize = anchor.AbsoluteSize

			local insidePopup =
				point.X >= popupPos.X
				and point.X <= popupPos.X + popupSize.X
				and point.Y >= popupPos.Y
				and point.Y <= popupPos.Y + popupSize.Y

			local insideAnchor =
				point.X >= anchorPos.X
				and point.X <= anchorPos.X + anchorSize.X
				and point.Y >= anchorPos.Y
				and point.Y <= anchorPos.Y + anchorSize.Y

			if not insidePopup and not insideAnchor then
				self:_ClosePopup()
			end
		end)
	end)

	return popup
end

function Window:Notify(options)
	options = options or {}

	local theme = self.Theme
	local duration = math.max(0.5, tonumber(options.Duration) or 4)
	local accent = tableToColor(options.Color) or options.Color or theme.Accent

	if typeof(accent) ~= "Color3" then
		accent = theme.Accent
	end

	local titleText = tostring(options.Title or "Alphax")
	local contentText = tostring(options.Content or "")

	local viewportWidth =
