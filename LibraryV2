function AlphaxUI:RegisterTheme(name, data)
	if type(name) ~= "string" or name == "" then
		return false, "Nome de tema inválido."
	end

	if type(data) ~= "table" then
		return false, "Tema precisa ser uma tabela."
	end

	-- Usa Midnight como base, então o dev pode sobrescrever só o que quiser.
	Themes[name] = mergeTable(Themes.Midnight, data)
	return true
end

function AlphaxUI:GetTheme(name)
	local theme = Themes[name]

	if not theme then
		return nil
	end

	return cloneTable(theme)
end

function AlphaxUI:GetVersion()
	return VERSION
end

function AlphaxUI:GetThemes()
	local list = {}
	for name in pairs(Themes) do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

