				content.Position = UDim2.fromOffset(250, 0)
				content.Size = UDim2.new(1, -250, 1, 0)
			end
		end

		updateResponsive()
		self.Maid:Give(camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsive))
	end

