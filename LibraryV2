		ClearTextOnFocus = false,
		Font = Enum.Font.GothamMedium,
		PlaceholderText = options.Placeholder or "Digite...",
		PlaceholderColor3 = theme.Faint,
		Text = value,
		TextColor3 = theme.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(box, 11)
	addPadding(box, 13, 13, 0, 0)
	local boxStroke = addStroke(box, theme.Stroke, 0.38, 1)

	local controller = {}

	function controller:Set(newValue, fireCallback)
		value = tostring(newValue or "")
		box.Text = value

		if fireCallback ~= false then
			safeCallback(options.Callback, value, false)
		end
	end

	function controller:Get()
		return value
	end

	self.Window.Maid:Give(box.Focused:Connect(function()
		boxStroke.Color = theme.Accent
		boxStroke.Transparency = 0.28
	end))

	self.Window.Maid:Give(box.FocusLost:Connect(function(enterPressed)
		boxStroke.Color = theme.Stroke
		boxStroke.Transparency = 0.38

		local newValue = box.Text

		if options.Numeric then
			local numeric = tonumber(newValue)

			if numeric then
				if options.Min ~= nil then
					numeric = math.max(numeric, options.Min)
				end

				if options.Max ~= nil then
					numeric = math.min(numeric, options.Max)
				end

				newValue = tostring(numeric)
				box.Text = newValue
			elseif options.AllowInvalidNumeric ~= true then
				box.Text = value
				return
			end
		end

		value = newValue
		safeCallback(options.Callback, value, enterPressed)
	end))

	self.Window:_RegisterControl(options.Id, controller)

	if options.FireOnLoad then
		safeCallback(options.Callback, value, false)
	end

	return controller
end

