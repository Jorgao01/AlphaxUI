	local originalPosition = chrome.Position
	chrome.Position = UDim2.new(
		originalPosition.X.Scale,
		originalPosition.X.Offset,
		originalPosition.Y.Scale,
		originalPosition.Y.Offset + 12
	)

	root.BackgroundTransparency = 1

	tween(chrome, 0.24, {
		Position = originalPosition,
	})

	tween(root, 0.24, {
		BackgroundTransparency = 0,
	})

	return self
end

function Window:BindAccent(callback)
	table.insert(self.AccentBindings, callback)

	pcall(function()
		callback(self.Theme.Accent)
	end)

	return callback
end

function Window:SetAccent(color)
	local converted = tableToColor(color) or color
	if typeof(converted) ~= "Color3" then
		return false
	end

	self.Theme.Accent = converted
	self.Theme.Accent2 = converted:Lerp(Color3.new(1, 1, 1), 0.20)

	for _, callback in ipairs(self.AccentBindings) do
		pcall(function()
			callback(converted)
		end)
	end

	return true
end

function Window:SetTitle(title, subtitle)
	if title ~= nil then
		self.TitleLabel.Text = tostring(title)
	end

	if subtitle ~= nil then
		self.SubtitleLabel.Text = tostring(subtitle)
	end
end

function Window:SetToggleKey(keyCode)
	if typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode then
		self.ToggleKey = keyCode
		return true
	end
	return false
end

function Window:SetMinimized(state)
	if self.Destroyed then
		return
	end

	self.Minimized = state == true
	self:_ClosePopup()

	if self.Minimized then
		tween(self.Chrome, 0.22, {
			Size = self.MinimizedSize,
		})
	else
		if self.MobileMode then
			tween(self.Chrome, 0.22, {
				Size = UDim2.new(1, -22, 1, -60),
			})
		else
			tween(self.Chrome, 0.22, {
				Size = self.ExpandedSize,
			})
		end
	end
end

function Window:SetVisible(state)
	if self.Destroyed then
		return
	end

	self.Visible = state == true
	self.Gui.Enabled = self.Visible

	if self.BlurEffect then
		self.BlurEffect.Enabled = self.Visible
	end
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:Destroy()
	if self.Destroyed then
		return
	end

	self.Destroyed = true
	self:_ClosePopup()
	self.Maid:Clean()
end

function Window:_RegisterControl(id, controller)
	if id == nil or id == "" then
		return
	end

	self.Controls[tostring(id)] = controller
end

function Window:_RegisterSearchable(instance, text, section)
	table.insert(self.Searchables, {
		Instance = instance,
		Text = normalize(text),
		Section = section,
	})
end

function Window:_ApplySearch(query)
	local normalizedQuery = normalize(query)

	for _, item in ipairs(self.Searchables) do
		if item.Instance and item.Instance.Parent then
			local visible = normalizedQuery == ""
				or string.find(item.Text, normalizedQuery, 1, true) ~= nil

			item.Instance.Visible = visible
		end
	end

	-- Hide sections with no visible controls while searching.
	for _, tab in ipairs(self.Tabs) do
		for _, section in ipairs(tab.Sections) do
			if normalizedQuery == "" then
				section.Frame.Visible = true
			else
				local foundVisible = false

				for _, control in ipairs(section.Controls) do
					if control.Parent and control.Visible then
						foundVisible = true
						break
					end
				end

				section.Frame.Visible = foundVisible
			end
		end
	end
end

function Window:GetConfigTable()
	local data = {}

	for id, controller in pairs(self.Controls) do
		if type(controller.Get) == "function" then
			local ok, value = pcall(function()
				return controller:Get()
			end)

			if ok then
				data[id] = value
			end
		end
	end

	return data
end

function Window:GetConfig()
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(self:GetConfigTable())
	end)

	if not ok then
		return nil, encoded
	end

	return encoded
end

function Window:LoadConfig(jsonOrTable, fireCallbacks)
	local data = jsonOrTable

	if type(jsonOrTable) == "string" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(jsonOrTable)
		end)

		if not ok then
			return false, decoded
		end

		data = decoded
	end

	if type(data) ~= "table" then
		return false, "Config precisa ser uma tabela ou JSON válido."
	end

	for id, value in pairs(data) do
		local controller = self.Controls[tostring(id)]

		if controller and type(controller.Set) == "function" then
			pcall(function()
				controller:Set(value, fireCallbacks == true)
			end)
		end
	end

	return true
end

function Window:_ClosePopup()
	if self.ActivePopup then
		local popup = self.ActivePopup

		self.ActivePopup = nil

		if popup.Connection then
			pcall(function()
				popup.Connection:Disconnect()
			end)
		end

		if popup.Frame and popup.Frame.Parent then
			popup.Frame:Destroy()
		end
	end
end

function Window:_OpenMenu(anchor, items, onSelect, options)
	options = options or {}
	self:_ClosePopup()

	if not anchor or not anchor.Parent then
		return
	end

	local theme = self.Theme
	local absPos = anchor.AbsolutePosition
	local absSize = anchor.AbsoluteSize

	local width = options.Width or math.max(absSize.X, 210)
	local visibleCount = math.min(#items, options.MaxVisible or 6)
	local height = math.max(44, visibleCount * 38 + 12)

	local viewport = self.PopupLayer.AbsoluteSize
	local x = absPos.X
	local y = absPos.Y + absSize.Y + 7

	if x + width > viewport.X - 12 then
		x = math.max(12, viewport.X - width - 12)
	end

	if y + height > viewport.Y - 12 then
		y = math.max(12, absPos.Y - height - 7)
	end

	local popup = create("Frame", {
		Name = "Popup",
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 120,
		Parent = self.PopupLayer,
	})

	addCorner(popup, 12)
	addStroke(popup, theme.Accent, 0.28, 1)

	local shadow = create("Frame", {
		Position = UDim2.fromOffset(-3, -3),
		Size = UDim2.new(1, 6, 1, 6),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 119,
		Parent = popup,
	})
	addCorner(shadow, 14)

	local scroll = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = theme.Accent,
		ZIndex = 121,
		Parent = popup,
	})

	create("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})

	addPadding(scroll, 6, 6, 6, 6)

	for index, item in ipairs(items) do
		local itemText
		local selected = false

		if type(item) == "table" then
			itemText = tostring(item.Text or item.Name or item.Value or index)
			selected = item.Selected == true
		else
			itemText = tostring(item)
		end

		local button = create("TextButton", {
			AutoButtonColor = false,
			Size = UDim2.new(1, -4, 0, 33),
			BackgroundColor3 = selected and theme.Surface4 or theme.Surface2,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamMedium,
			Text = itemText,
			TextColor3 = selected and theme.Text or theme.Muted,
			TextSize = 11,
			ZIndex = 122,
			Parent = scroll,
		})

		addCorner(button, 8)

		if selected then
			addStroke(button, theme.Accent, 0.3, 1)
		end

		self.Maid:Give(button.MouseEnter:Connect(function()
			tween(button, 0.12, {
				BackgroundColor3 = theme.Surface4,
				TextColor3 = theme.Text,
			})
		end))

		self.Maid:Give(button.MouseLeave:Connect(function()
			tween(button, 0.12, {
				BackgroundColor3 = selected and theme.Surface4 or theme.Surface2,
				TextColor3 = selected and theme.Text or theme.Muted,
			})
		end))

		self.Maid:Give(button.MouseButton1Click:Connect(function()
			onSelect(item, index)

			if options.KeepOpen ~= true then
				self:_ClosePopup()
			end
		end))
	end

	local popupData = {
		Frame = popup,
		Connection = nil,
	}

	self.ActivePopup = popupData

	task.defer(function()
		if self.ActivePopup ~= popupData then
			return
		end

		popupData.Connection = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			local point = input.Position
			local popupPos = popup.AbsolutePosition
			local popupSize = popup.AbsoluteSize
			local anchorPos = anchor.AbsolutePosition
			local anchorSize = anchor.AbsoluteSize

			local insidePopup =
				point.X >= popupPos.X
				and point.X <= popupPos.X + popupSize.X
				and point.Y >= popupPos.Y
				and point.Y <= popupPos.Y + popupSize.Y

			local insideAnchor =
				point.X >= anchorPos.X
				and point.X <= anchorPos.X + anchorSize.X
				and point.Y >= anchorPos.Y
				and point.Y <= anchorPos.Y + anchorSize.Y

			if not insidePopup and not insideAnchor then
				self:_ClosePopup()
			end
		end)
	end)

	return popup
end

