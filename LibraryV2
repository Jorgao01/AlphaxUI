local function resolveSizePixels(size, viewport)
	return Vector2.new(
		(viewport.X * size.X.Scale) + size.X.Offset,
		(viewport.Y * size.Y.Scale) + size.Y.Offset
	)
end

local function clampWindowPosition(target, desiredPosition, sizeOverride, margin)
	local camera = workspace.CurrentCamera

	if not camera then
		return desiredPosition
	end

	local viewport = camera.ViewportSize
	margin = margin or 10

	local sizePixels = resolveSizePixels(sizeOverride or target.Size, viewport)

	local centerX =
		(viewport.X * desiredPosition.X.Scale)
		+ desiredPosition.X.Offset

	local centerY =
		(viewport.Y * desiredPosition.Y.Scale)
		+ desiredPosition.Y.Offset

	-- Mantém a janela inteira na tela quando possível.
	-- Se a janela for maior que o viewport, mantém ao menos o centro seguro.
	local usableWidth = math.max(1, viewport.X - (margin * 2))
	local usableHeight = math.max(1, viewport.Y - (margin * 2))

	if sizePixels.X >= usableWidth then
		centerX = viewport.X / 2
	else
		local halfWidth = sizePixels.X / 2
		centerX = math.clamp(
			centerX,
			margin + halfWidth,
			viewport.X - margin - halfWidth
		)
	end

	if sizePixels.Y >= usableHeight then
		centerY = viewport.Y / 2
	else
		local halfHeight = sizePixels.Y / 2
		centerY = math.clamp(
			centerY,
			margin + halfHeight,
			viewport.Y - margin - halfHeight
		)
	end

	return UDim2.fromOffset(
		math.floor(centerX + 0.5),
		math.floor(centerY + 0.5)
	)
end

local function makeDraggable(handle, target, maid, canDrag)
	local dragging = false
	local dragInput = nil
	local startInputPosition = nil
	local startTargetPosition = nil

	maid:Give(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			if canDrag and not canDrag() then
				return
			end

			dragging = true
			startInputPosition = input.Position
			startTargetPosition = target.Position

			local changedConnection

			changedConnection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false

					if changedConnection then
						changedConnection:Disconnect()
						changedConnection = nil
					end

					-- Revalida a posição ao soltar.
					if target and target.Parent then
						target.Position = clampWindowPosition(
							target,
							target.Position,
							target.Size,
							10
						)
					end
				end
			end)
		end
	end))

	maid:Give(handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			dragInput = input
		end
	end))

	maid:Give(UserInputService.InputChanged:Connect(function(input)
		if not dragging or input ~= dragInput then
			return
		end

		if not startInputPosition or not startTargetPosition then
			return
		end

		local delta = input.Position - startInputPosition

		local proposed = UDim2.new(
			startTargetPosition.X.Scale,
			startTargetPosition.X.Offset + delta.X,
			startTargetPosition.Y.Scale,
			startTargetPosition.Y.Offset + delta.Y
		)

		target.Position = clampWindowPosition(
			target,
			proposed,
			target.Size,
			10
		)
	end))
end

