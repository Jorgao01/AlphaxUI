function Section:AddSlider(options)
	options = options or {}

	local theme = self.Window.Theme
	local name = options.Name or "Slider"
	local description = options.Description or ""

	local minValue = tonumber(options.Min) or 0
	local maxValue = tonumber(options.Max) or 100
	local increment = tonumber(options.Increment) or 1

	if maxValue < minValue then
		minValue, maxValue = maxValue, minValue
	end

	local decimals = options.Decimals
	if decimals == nil then
		decimals = countDecimals(increment)
	end

	local value = roundToIncrement(
		tonumber(options.Default) or minValue,
		minValue,
		maxValue,
		increment
	)

	local row = self:_CreateRow(
		description ~= "" and 118 or 104,
		name .. " " .. description
	)

	self:_CreateTextBlock(row, name, description, UDim2.new(1, -105, 0, 60))

	local valueBadge = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(64, 32),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = formatNumber(value, decimals),
		TextColor3 = theme.Accent2,
		TextSize = 12,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(valueBadge, 9)
	local badgeStroke = addStroke(valueBadge, theme.Accent, 0.48, 1)

	self.Window:BindAccent(function(accent)
		badgeStroke.Color = accent
	end)

	local barY = description ~= "" and 77 or 66

	local track = create("Frame", {
		Position = UDim2.fromOffset(18, barY),
		Size = UDim2.new(1, -36, 0, 10),
		BackgroundColor3 = theme.Surface4,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = row,
	})

	addCorner(track, 6)

	local alpha = (value - minValue) / math.max(maxValue - minValue, 0.000001)

	local fill = create("Frame", {
		Size = UDim2.new(alpha, 0, 1, 0),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = track,
	})

	addCorner(fill, 6)
	local fillGradient = addGradient(fill, theme.Accent2, theme.Accent, 0)

	local knobGlow = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(alpha, 0, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = theme.Accent,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = track,
	})

	addCorner(knobGlow, 15)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(alpha, 0, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Color3.fromRGB(229, 222, 255),
		BorderSizePixel = 0,
		ZIndex = 12,
		Parent = track,
	})

	addCorner(knob, 10)
	local knobStroke = addStroke(knob, theme.Accent, 0.05, 2)

	self.Window:BindAccent(function(accent)
		fill.BackgroundColor3 = accent
		knobGlow.BackgroundColor3 = accent
		knobStroke.Color = accent
		valueBadge.TextColor3 = self.Window.Theme.Accent2
		fillGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, self.Window.Theme.Accent2),
			ColorSequenceKeypoint.new(1, accent),
		})
	end)

	-- Tick marks, similar to the reference image.
	local tickCount = options.TickCount or 14

	for index = 0, tickCount do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(index / tickCount, 0, 1, 9),
			Size = UDim2.fromOffset(1, 5),
			BackgroundColor3 = theme.Faint,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 9,
			Parent = track,
		})
	end

	create("TextLabel", {
		Position = UDim2.fromOffset(0, 19),
		Size = UDim2.fromOffset(50, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = formatNumber(minValue, decimals),
		TextColor3 = theme.Muted,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 10,
		Parent = track,
	})

	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 19),
		Size = UDim2.fromOffset(50, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = formatNumber(maxValue, decimals),
		TextColor3 = theme.Muted,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 10,
		Parent = track,
	})

	local dragging = false
	local controller = {}

	local function render()
		local currentAlpha = (value - minValue) / math.max(maxValue - minValue, 0.000001)

		fill.Size = UDim2.new(currentAlpha, 0, 1, 0)
		knob.Position = UDim2.new(currentAlpha, 0, 0.5, 0)
		knobGlow.Position = UDim2.new(currentAlpha, 0, 0.5, 0)

		valueBadge.Text = formatNumber(value, decimals)
	end

	function controller:Set(newValue, fireCallback)
		local numeric = tonumber(newValue)
		if not numeric then
			return
		end

		value = roundToIncrement(
			numeric,
			minValue,
			maxValue,
			increment
		)

		render()

		if fireCallback ~= false then
			safeCallback(options.Callback, value)
		end
	end

	function controller:Get()
		return value
	end

	local function updateFromPosition(x)
		local width = math.max(track.AbsoluteSize.X, 1)
		local percent = math.clamp(
			(x - track.AbsolutePosition.X) / width,
			0,
			1
		)

		controller:Set(
			minValue + (maxValue - minValue) * percent,
			true
		)
	end

	self.Window.Maid:Give(track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			updateFromPosition(input.Position.X)
		end
	end))

	self.Window.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			updateFromPosition(input.Position.X)
		end
	end))

	self.Window.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end))

	self.Window:_RegisterControl(options.Id, controller)

	if options.FireOnLoad then
		safeCallback(options.Callback, value)
	end

	return controller
end

