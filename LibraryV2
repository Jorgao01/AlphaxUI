			return
		end

		if input.KeyCode == Enum.KeyCode.Slash then
			task.defer(function()
				if self.Visible and searchBox.Parent then
					searchBox:CaptureFocus()
				end
			end)
		end
	end))

	-- Responsive sizing without overwriting the user's desired desktop size.
	local camera = workspace.CurrentCamera
	if camera then
		local function updateResponsive()
			if self.Destroyed then
				return
			end

			local viewport = camera.ViewportSize

			if viewport.X <= 760 or viewport.Y <= 520 then
				self.MobileMode = true

				if not self.Minimized then
					chrome.Size = UDim2.new(1, -22, 1, -60)
