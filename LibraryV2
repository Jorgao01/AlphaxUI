function Window:SelectTab(tab)
	if self._destroyed or self.ActiveTab == tab then
		return
	end

	for _, item in ipairs(self.Tabs) do
		local active = item == tab
		item.Page.Visible = active

		tween(item.Button, 0.16, {
			BackgroundTransparency = active and 0 or 1,
			BackgroundColor3 = active and self.Theme.Surface2 or self.Theme.Surface,
		})
		tween(item.Label, 0.16, {
			TextColor3 = active and self.Theme.Text or self.Theme.Muted,
		})
		tween(item.Icon, 0.16, {
			TextColor3 = active and self.Theme.Accent or self.Theme.Muted,
		})
		tween(item.Indicator, 0.16, {
			BackgroundTransparency = active and 0 or 1,
		})
	end

	self.ActiveTab = tab
	self.PageTitle.Text = tab.Name
	self.PageDescription.Text = tab.Description ~= "" and tab.Description or "Configurações e controles."
end

