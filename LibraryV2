function Window:_MoveTabIndicator(tab, instant)
	if self.Destroyed
		or not tab
		or not tab.Button
		or not tab.Button.Parent
		or not self.TabIndicator
		or not self.Sidebar then
		return
	end

	local button = tab.Button
	local sidebar = self.Sidebar
	local indicator = self.TabIndicator

	-- AbsolutePosition já considera CanvasPosition do ScrollingFrame.
	local relativeX =
		button.AbsolutePosition.X
		- sidebar.AbsolutePosition.X

	local relativeY =
		button.AbsolutePosition.Y
		- sidebar.AbsolutePosition.Y

	local width = button.AbsoluteSize.X
	local height = button.AbsoluteSize.Y

	if width <= 1 or height <= 1 then
		task.defer(function()
			if not self.Destroyed then
				self:_MoveTabIndicator(tab, true)
			end
		end)
		return
	end

	local targetPosition = UDim2.fromOffset(
		math.floor(relativeX + 0.5),
		math.floor(relativeY + 0.5)
	)

	local targetSize = UDim2.fromOffset(
		math.floor(width + 0.5),
		math.floor(height + 0.5)
	)

	if instant or not self.TabIndicatorReady then
		indicator.Position = targetPosition
		indicator.Size = targetSize
		indicator.BackgroundTransparency = 0.06
		indicator.Visible = true
		self.TabIndicatorReady = true
		return
	end

	indicator.Visible = true

	-- Movimento um pouco mais longo para ficar claramente perceptível.
	tween(
		indicator,
		0.30,
		{
			Position = targetPosition,
			Size = targetSize,
			BackgroundTransparency = 0.06,
		},
		Enum.EasingStyle.Quint
	)

	-- Pequena intensificação durante a viagem.
	if self.TabIndicatorGlow then
		tween(
			self.TabIndicatorGlow,
			0.15,
			{BackgroundTransparency = 0.84},
			Enum.EasingStyle.Quint
		)

		task.delay(0.15, function()
			if self.TabIndicatorGlow and self.TabIndicatorGlow.Parent then
				tween(
					self.TabIndicatorGlow,
					0.18,
					{BackgroundTransparency = 0.92},
					Enum.EasingStyle.Quint
				)
			end
		end)
	end
end

