function Section:AddMultiDropdown(options)
	options = options or {}

	local theme = self.Window.Theme
	local name = options.Name or "Multi Dropdown"
	local description = options.Description or ""
	local values = options.Options or {}
	local selected = {}

	for _, value in ipairs(options.Default or {}) do
		selected[value] = true
	end

	local row = self:_CreateRow(
		description ~= "" and 78 or 64,
		name .. " " .. description .. " " .. table.concat(values, " ")
	)

	self:_CreateTextBlock(row, name, description, UDim2.new(0.50, -12, 1, 0))

	local selector = create("TextButton", {
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.new(0.45, 0, 0, 44),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		Text = "",
		ZIndex = 10,
		Parent = row,
	})

	addCorner(selector, 12)
	local selectorStroke = addStroke(selector, theme.Accent, 0.52, 1)

	self.Window:BindAccent(function(accent)
		selectorStroke.Color = accent
	end)

	local selectedLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -48, 1, 0),
		Font = Enum.Font.GothamBold,
		Text = "Nenhum",
		TextColor3 = theme.Text,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 11,
		Parent = selector,
	})

	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "⌄",
		TextColor3 = theme.Text,
		TextSize = 15,
		ZIndex = 11,
		Parent = selector,
	})

	local controller = {}

	local function listSelected()
		local result = {}

		for _, optionValue in ipairs(values) do
			if selected[optionValue] then
				table.insert(result, optionValue)
			end
		end

		return result
	end

	local function render()
		local current = listSelected()

		if #current == 0 then
			selectedLabel.Text = "Nenhum"
		elseif #current <= 2 then
			selectedLabel.Text = table.concat(current, ", ")
		else
			selectedLabel.Text = tostring(#current) .. " selecionados"
		end
	end

	function controller:Set(newValues, fireCallback)
		selected = {}

		if type(newValues) == "table" then
			for _, value in ipairs(newValues) do
				if table.find(values, value) then
					selected[value] = true
				end
			end
		end

		render()

		if fireCallback ~= false then
			safeCallback(options.Callback, listSelected())
		end
	end

	function controller:Get()
		return listSelected()
	end

	function controller:SetOptions(newOptions, preserveSelection)
		values = newOptions or {}

		if not preserveSelection then
			selected = {}
		else
			for selectedValue in pairs(selected) do
				if not table.find(values, selectedValue) then
					selected[selectedValue] = nil
				end
			end
		end

		render()
	end

	local function openMenu()
		local menuItems = {}

		for _, value in ipairs(values) do
			table.insert(menuItems, {
				Text = (selected[value] and "✓  " or "○  ") .. tostring(value),
				Value = value,
				Selected = selected[value] == true,
			})
		end

		self.Window:_OpenMenu(selector, menuItems, function(item)
			selected[item.Value] = not selected[item.Value]
			render()
			safeCallback(options.Callback, listSelected())

			-- _OpenMenu fecha este popup após o clique. Reabrimos no
			-- frame seguinte para atualizar os checks sem criar recursão.
			task.defer(function()
				if selector and selector.Parent and self.Window.Visible then
					openMenu()
				end
			end)
		end, {
			Width = math.max(selector.AbsoluteSize.X, 240),
			MaxVisible = 6,
		})
	end

	render()

	self.Window.Maid:Give(selector.MouseButton1Click:Connect(function()
		openMenu()
	end))

	self.Window:_RegisterControl(options.Id, controller)

	if options.FireOnLoad then
		safeCallback(options.Callback, listSelected())
	end

	return controller
end

