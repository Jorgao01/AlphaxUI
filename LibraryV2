			},
			Enum.EasingStyle.Back
		)
	end))

	tab.Maid:Give(button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end))

	table.insert(self.Tabs, tab)

	if self.MobileMode and tab.PagePadding then
		tab.PagePadding.PaddingLeft = UDim.new(0, 14)
		tab.PagePadding.PaddingRight = UDim.new(0, 14)
		tab.PagePadding.PaddingTop = UDim.new(0, 3)
		tab.PagePadding.PaddingBottom = UDim.new(0, 18)
	end

	if not self.ActiveTab then
		self:SelectTab(tab)
	end

	return tab
end

function Window:SelectTab(tab)
	if self.Destroyed or not tab then
		return
	end

	if self.ActiveTab == tab then
		return
	end

	self:_ClosePopup()

	local previous = self.ActiveTab

	-- Atualiza primeiro para impedir callbacks de hover de tratarem
	-- a tab nova como inativa durante o mesmo frame.
	self.ActiveTab = tab

	for _, current in ipairs(self.Tabs) do
		local active = current == tab

		current.Page.Visible = active
		current.Button.BackgroundTransparency = 1

		-- Estado visual determinístico: evita o texto/ícone escurecer
		-- atrás do indicador em trocas rápidas.
		current.Label.TextColor3 =
			active and self.Theme.Text or self.Theme.Muted

		current.Label.TextTransparency = active and 0.10 or 0

		if active then
			tween(current.Label, 0.18, {
				TextTransparency = 0,
			})
		end

		setVectorIconColor(
			current.Icon,
			active and self.Theme.Accent or self.Theme.Muted
		)

		current.ActiveBar.BackgroundTransparency = 1

		tween(current.IconGlow, 0.18, {
			BackgroundTransparency = active and 0.82 or 1,
		})

		current.ButtonStroke.Transparency = 1
	end

	self.PageTitle.Text = tab.Name
	self.PageDescription.Text = tab.Description

	if self.StatusPageLabel then
		self.StatusPageLabel.Text = tab.Name
	end

	self:_MoveTabIndicator(tab, previous == nil)

	if tab.Page then
		local pageScale = tab.Page:FindFirstChild("AlphaxTabPageScale")

		if not pageScale then
			pageScale = create("UIScale", {
				Name = "AlphaxTabPageScale",
				Scale = 1,
				Parent = tab.Page,
			})
		end

		pageScale.Scale = 0.992

		tween(
			pageScale,
			0.24,
			{Scale = 1},
			Enum.EasingStyle.Quint
		)
	end

	if self.MobileMode then
		self:SetMobileSidebar(false)
	end

	if self.SearchBox.Text ~= "" then
		self:_ApplySearch(self.SearchBox.Text)
	end
end

